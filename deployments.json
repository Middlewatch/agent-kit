{
  "bindings": {
    "kit": ".",
    "wiki": "~/wiki",
    "inbox": "~/wiki/inbox",
    "journals": "~/journals",
    "reference": "~/reference",
    "projects": "~/projects"
  },
  "links": [
    {
      "source": "kit/guidance/AGENTS.md",
      "target": "~/.agents/AGENTS.md"
    },
    {
      "source": "kit/guidance/CLAUDE.md",
      "target": "~/.agents/CLAUDE.md"
    },
    {
      "source": "kit/skills",
      "target": "~/.agents/skills"
    },
    {
      "source": "~/.agents/AGENTS.md",
      "target": "~/.pi/agent/AGENTS.md"
    },
    {
      "source": "~/.agents/CLAUDE.md",
      "target": "~/.claude/CLAUDE.md"
    },
    {
      "source": "~/.agents/skills",
      "target": "~/.claude/skills"
    },
    {
      "source": "~/.agents/AGENTS.md",
      "target": "~/.codex/AGENTS.md"
    },
    {
      "source": "~/.agents/kit/extensions/pi-tui/themes/modus-vivendi-tinted.json",
      "target": "~/.pi/agent/themes/modus-vivendi-tinted.json"
    },
    {
      "source": "~/.agents/skills",
      "target": "~/.codex/skills"
    }
  ],
  "tools": [
    {
      "name": "sess",
      "bin": "tools/sess/zig-out/bin/sess",
      "build": "zig build"
    },
    {
      "name": "prefixdiff",
      "bin": "tools/prefixdiff/zig-out/bin/prefixdiff",
      "build": "zig build"
    },
    {
      "name": "slopcheck",
      "bin": "skills/slopfix/slopcheck.py"
    },
    {
      "name": "trail",
      "bin": "skills/evoker-mode/tools/trail/trail"
    },
    {
      "name": "portaudit",
      "bin": "tools/portaudit/portaudit"
    },
    {
      "name": "introspect-scan",
      "bin": "tools/introspect-scan/introspect-scan"
    }
  ],
  "pi_package": [
    "~/.agents/kit",
    "npm:@middlewatch/pi-agent-kit",
    "git:github.com/Middlewatch/agent-kit"
  ],
  "pi_retire": [
    "~/projects/skills",
    "~/projects/extensions",
    "git:github.com/Middlewatch/agent-skills",
    "git:github.com/Middlewatch/pi-extensions",
    "~/projects/sysprompt-editor",
    "git:github.com/Middlewatch/pi-sysprompt-editor"
  ],
  "pi_legacy_paths": [
    "~/.pi/agent/extensions/lemonade-current",
    "~/.pi/agent/extensions/pi-interlock",
    "~/.pi/agent/extensions/pi-scratchpad",
    "~/.pi/agent/extensions/agent-delegate",
    "~/.pi/agent/skills/as-built",
    "~/.pi/agent/skills/deep-research",
    "~/.pi/agent/skills/deep-review",
    "~/.pi/agent/skills/design-basis",
    "~/.pi/agent/skills/design-conformance",
    "~/.pi/agent/skills/execute",
    "~/.pi/agent/skills/harvest",
    "~/.pi/agent/skills/plan",
    "~/.pi/agent/skills/project-scaffold",
    "~/.pi/agent/skills/public-release",
    "~/.pi/agent/skills/slopfix",
    "~/.pi/agent/skills/structural-review",
    "~/.pi/agent/skills/tui-live-review",
    "~/.pi/agent/skills/vet-dependency"
  ]
}
