{
  "root": "~/agent-kit",
  "bindings": {
    "wiki": "~/wiki",
    "inbox": "~/wiki/inbox",
    "journals": "~/journals",
    "reference": "~/reference",
    "projects": "~/projects"
  },
  "harnesses": [
    {
      "name": "pi",
      "env": "PI_CODING_AGENT_DIR",
      "legacy": "~/.pi/agent"
    },
    {
      "name": "claude",
      "env": "CLAUDE_CONFIG_DIR",
      "legacy": "~/.claude"
    },
    {
      "name": "codex",
      "env": "CODEX_HOME",
      "legacy": "~/.codex"
    }
  ],
  "legacy_bindings": "~/.agents",
  "links": [
    {
      "source": "~/agent-kit/guidance/workspaces/projects/AGENTS.md",
      "target": "~/agent-kit/projects/AGENTS.md"
    },
    {
      "source": "AGENTS.md",
      "target": "~/agent-kit/projects/CLAUDE.md"
    }
  ],
  "tools": [
    {
      "name": "sess",
      "bin": "tools/sess/zig-out/bin/sess",
      "build": "zig build"
    },
    {
      "name": "prefixdiff",
      "bin": "tools/prefixdiff/zig-out/bin/prefixdiff",
      "build": "zig build"
    },
    {
      "name": "slopcheck",
      "bin": "skills/slopfix/slopcheck.py"
    },
    {
      "name": "trail",
      "bin": "skills/evoker-mode/tools/trail/trail"
    },
    {
      "name": "portaudit",
      "bin": "tools/portaudit/portaudit"
    },
    {
      "name": "introspect-scan",
      "bin": "tools/introspect-scan/introspect-scan"
    }
  ],
  "pi_package": "~/agent-kit",
  "pi_retire": [
    "~/.agents/kit"
  ]
}
