#!/usr/bin/env bash
# Install the agent kit on this machine. The kit checkout is the one install
# target (manifest "root", ~/agent-kit): the script creates the bindings
# inside it, migrates each harness's state out of its old dot-directory into
# the kit's harness directory, makes the workspace links, builds and links the
# tools, installs extension dependencies, registers the pi package, then runs
# bin/check. Idempotent; re-running is a no-op. Needs bash 4+, GNU coreutils
# (realpath -m), python3, and npm for extensions that carry a lockfile. Put
# ~/.local/bin on PATH and set the harness environment variables yourself
# (README, "Environment").
#
# usage: bin/install [--kit DIR] [--bind NAME=PATH]... [--rebind] [--dry-run]
#
# A real file or directory in a link's place, and a migrated entry whose
# destination already exists, move under
# ${XDG_STATE_HOME:-~/.local/state}/agent-kit/backup/<stamp>/<path under HOME>.
# Tool `build` strings in the manifest run as shell in the tool's directory,
# so `--kit DIR` executes whatever DIR/deployments.json says.
set -u

KIT=""
REBIND=0
DRY=0
declare -A BIND_OVERRIDE=()

usage() { sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; }

abspath() {
  # Resolve against the invocation cwd; the path need not exist yet.
  realpath -m -- "$1"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --kit) KIT=$(abspath "$2"); shift 2 ;;
    --bind)
      name=${2%%=*}; path=${2#*=}
      [ -n "$name" ] && [ "$name" != "$2" ] || { echo "bad --bind: $2" >&2; exit 2; }
      BIND_OVERRIDE[$name]=$(abspath "$path"); shift 2 ;;
    --rebind) REBIND=1; shift ;;
    --dry-run) DRY=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

[ -n "$KIT" ] || KIT=$(realpath -- "$(dirname -- "$0")/..")
MANIFEST="$KIT/deployments.json"
[ -f "$MANIFEST" ] || { echo "no manifest at $MANIFEST" >&2; exit 2; }
BACKUP_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/agent-kit/backup"
FAILED=0
MISSING=0
BACKUP_DIR=""
LOG_DIR=""

say() { printf '%s\n' "$*"; }
fail() { say "FAIL $*"; FAILED=1; }

expand() {
  # "." -> kit root, "~/x" -> $HOME/x, else unchanged.
  case "$1" in
    .) printf '%s' "$KIT" ;;
    "~") printf '%s' "$HOME" ;;
    "~/"*) printf '%s/%s' "$HOME" "${1#\~/}" ;;
    *) printf '%s' "$1" ;;
  esac
}

# Emit the manifest as TSV rows: root<TAB>path, binding<TAB>name<TAB>path,
# migrate<TAB>legacy<TAB>dest, link<TAB>source<TAB>target,
# tool<TAB>name<TAB>bin<TAB>build.
manifest_rows() {
  python3 - "$MANIFEST" <<'PY'
import json, sys
m = json.load(open(sys.argv[1]))
print(f"root\t{m.get('root', '~/agent-kit')}")
for name, path in m.get("bindings", {}).items():
    print(f"binding\t{name}\t{path}")
legacy = m.get("legacy_bindings")
if legacy:
    print(f"migrate\t{legacy}\t.")
for h in m.get("harnesses", []):
    if h.get("legacy"):
        print(f"migrate\t{h['legacy']}\t{h['name']}")
for link in m.get("links", []):
    print(f"link\t{link['source']}\t{link['target']}")
for tool in m.get("tools", []):
    print(f"tool\t{tool['name']}\t{tool['bin']}\t{tool.get('build', '')}")
PY
}

# One backup directory per run, minted on first use (sets BACKUP_DIR; never
# call inside $(...), which would lose the assignment to a subshell).
ensure_backup_dir() {
  [ -n "$BACKUP_DIR" ] && return 0
  local stamp base n
  stamp=$(date +%Y%m%dT%H%M%S)
  base="$BACKUP_ROOT/$stamp"
  BACKUP_DIR="$base"; n=1
  while [ -e "$BACKUP_DIR" ]; do BACKUP_DIR="$base-$n"; n=$((n + 1)); done
  mkdir -p "$BACKUP_DIR"
}

# backup_path TARGET: where TARGET goes inside the run's backup dir, mirroring
# its path under HOME so same-named targets never collide.
backup_path() {
  local rel
  case "$1" in
    "$HOME"/*) rel=${1#"$HOME"/} ;;
    *) rel="abs/${1#/}" ;;
  esac
  printf '%s/%s' "$BACKUP_DIR" "$rel"
}

# move_to_backup PATH REASON: move PATH under the run's backup dir.
move_to_backup() {
  local src=$1 reason=$2 dest
  if [ "$DRY" = 1 ]; then
    say "backup  $src -> $BACKUP_ROOT/<stamp>/... ($reason)"; return 0
  fi
  ensure_backup_dir
  dest=$(backup_path "$src")
  say "backup  $src -> $dest ($reason)"
  mkdir -p -- "$(dirname -- "$dest")" && mv -- "$src" "$dest" || { fail "backup $src"; return 1; }
}

# ensure_link TARGET SOURCE_TEXT MODE KEEP_FOREIGN
# Per-target state table: absent -> create; symlink to intended -> no-op;
# symlink elsewhere or dangling -> replace; real file/dir -> backup, then link.
# MODE "text": the link text must equal SOURCE_TEXT exactly (manifest links).
# MODE "real": any spelling that resolves to SOURCE_TEXT is fine (bindings,
# tool links). KEEP_FOREIGN=1 leaves a symlink that points elsewhere alone
# (bindings without --rebind).
ensure_link() {
  local target=$1 text=$2 mode=$3 keep=$4 ok
  if [ -L "$target" ]; then
    local current
    current=$(readlink -- "$target")
    if [ "$mode" = text ]; then
      [ "$current" = "$text" ] && ok=1 || ok=0
    else
      [ "$(realpath -m -- "$target")" = "$(realpath -m -- "$text")" ] && ok=1 || ok=0
    fi
    if [ "$ok" = 1 ]; then
      say "ok      $target -> $text"; return 0
    fi
    if [ -e "$target" ] && [ "$keep" = 1 ]; then
      say "kept    $target -> $current (use --rebind to replace)"; return 0
    fi
    say "replace $target -> $text (was $current)"
    [ "$DRY" = 1 ] && return 0
    rm -f -- "$target" && ln -s -- "$text" "$target" || { fail "link $target"; return 1; }
    return 0
  fi
  if [ -e "$target" ]; then
    move_to_backup "$target" "in the way of a link" || return 1
    [ "$DRY" = 1 ] && return 0
    ln -s -- "$text" "$target" || { fail "link $target"; return 1; }
    return 0
  fi
  say "link    $target -> $text"
  [ "$DRY" = 1 ] && return 0
  mkdir -p -- "$(dirname -- "$target")" && ln -s -- "$text" "$target" || { fail "link $target"; return 1; }
}

# The kit must sit at the manifest root: every reference in guidance, skills,
# and docs is written against that path.
check_root() {
  local root
  root=$(expand "$(manifest_rows | awk -F'\t' '$1 == "root" { print $2 }')")
  if [ "$(realpath -m -- "$KIT")" != "$(realpath -m -- "$root")" ]; then
    fail "kit is at $KIT; the manifest root is $root. Clone or move it there, then rerun."
    return 1
  fi
  say "ok      kit at $root"
}

ensure_bindings() {
  while IFS=$'\t' read -r kind name path; do
    [ "$kind" = binding ] || continue
    local src
    if [ -n "${BIND_OVERRIDE[$name]+x}" ]; then src=${BIND_OVERRIDE[$name]}; else src=$(expand "$path"); fi
    if [ ! -d "$src" ]; then
      say "missing $name: $src"; MISSING=1; continue
    fi
    ensure_link "$KIT/$name" "$src" real "$((1 - REBIND))"
  done < <(manifest_rows)
}

# Move one legacy directory's contents into the kit (dest "." is the root,
# otherwise a harness directory). Symlinks of the old layout (anything
# resolving into ~/.agents or the kit, and every symlink in the old binding
# dir) are dropped: the tracked tree provides them now. An entry whose
# destination already exists goes to the backup. The emptied directory is
# removed, and so is its parent when that leaves it empty (~/.pi).
migrate_dir() {
  local src=$1 dest=$2 to entry name resolved
  to="$KIT/$dest"; [ "$dest" = . ] && to="$KIT"
  [ "$(realpath -m -- "$src")" = "$(realpath -m -- "$to")" ] && return 0
  say "migrate $src -> $to"
  for entry in "$src"/* "$src"/.[!.]* "$src"/..?*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    name=${entry##*/}
    if [ -L "$entry" ]; then
      resolved=$(realpath -m -- "$entry")
      case "$dest/$resolved" in
        ./*|*"/$HOME/.agents"|*"/$HOME/.agents/"*|*"/$KIT"|*"/$KIT/"*)
          say "drop    $entry -> $(readlink -- "$entry") (the kit tree provides it)"
          [ "$DRY" = 1 ] || rm -f -- "$entry" || fail "drop $entry"
          continue ;;
      esac
    fi
    if [ "$dest" = . ] && [ "$name" = backup ] && [ -d "$entry" ]; then
      say "migrate $entry/* -> $BACKUP_ROOT/"
      if [ "$DRY" = 0 ]; then
        mkdir -p -- "$BACKUP_ROOT" \
          && find "$entry" -mindepth 1 -maxdepth 1 -exec mv -t "$BACKUP_ROOT" -- {} + \
          && rmdir -- "$entry" || fail "migrate $entry"
      fi
      continue
    fi
    if [ -e "$to/$name" ] || [ -L "$to/$name" ]; then
      move_to_backup "$entry" "$to/$name exists"
      continue
    fi
    say "migrate $entry -> $to/$name"
    [ "$DRY" = 1 ] || { mkdir -p -- "$to" && mv -- "$entry" "$to/$name"; } || fail "migrate $entry"
  done
  if [ "$DRY" = 1 ]; then say "remove  $src (once empty)"; return 0; fi
  rmdir -- "$src" || { fail "remove $src: not empty"; return 1; }
  local parent; parent=$(dirname -- "$src")
  [ "$parent" != "$HOME" ] && rmdir -- "$parent" 2>/dev/null
  return 0
}

migrate_legacy() {
  while IFS=$'\t' read -r kind legacy dest; do
    [ "$kind" = migrate ] || continue
    local src; src=$(expand "$legacy")
    [ -d "$src" ] && [ ! -L "$src" ] || continue
    migrate_dir "$src" "$dest"
  done < <(manifest_rows)
}

ensure_links() {
  while IFS=$'\t' read -r kind source target; do
    [ "$kind" = link ] || continue
    local tgt text
    tgt=$(expand "$target")
    text=$(expand "$source")   # relative sources stay relative to the link's directory
    ensure_link "$tgt" "$text" text 0
  done < <(manifest_rows)
}

tool_skipped() {
  # Skipped when the first word of `build` is not on PATH.
  local build=$1
  [ -n "$build" ] || return 1
  command -v -- "${build%% *}" >/dev/null 2>&1 && return 1
  return 0
}

log_dir() {
  [ -n "$LOG_DIR" ] || LOG_DIR=$(mktemp -d "${TMPDIR:-/tmp}/agent-kit-install.XXXXXX")
  printf '%s' "$LOG_DIR"
}

build_and_link_tools() {
  while IFS=$'\t' read -r kind name bin build; do
    [ "$kind" = tool ] || continue
    if tool_skipped "$build"; then
      say "skipped $name: ${build%% *} not found"; continue
    fi
    local dir="$KIT/tools/$name" binpath="$KIT/$bin"
    if [ -n "$build" ]; then
      say "build   $name: ($dir) $build"
      if [ "$DRY" = 0 ]; then
        if [ ! -d "$dir" ]; then fail "build $name: no directory $dir"; continue; fi
        local log; log="$(log_dir)/build-$name.log"
        if ! (cd "$dir" && eval "$build") >"$log" 2>&1; then
          fail "build $name: see $log"; continue
        fi
      fi
    fi
    if [ "$DRY" = 0 ] && [ ! -x "$binpath" ]; then
      fail "tool $name: no executable at $binpath"; continue
    fi
    ensure_link "$HOME/.local/bin/$name" "$binpath" real 0
  done < <(manifest_rows)
}

# Extensions with a lockfile need their node_modules on a fresh clone; pi
# loads a local package in place and installs nothing for it.
install_extension_deps() {
  local lock dir
  for lock in "$KIT"/extensions/*/package-lock.json; do
    [ -f "$lock" ] || continue
    dir=${lock%/package-lock.json}
    [ -d "$dir/node_modules" ] && continue
    if ! command -v npm >/dev/null 2>&1; then
      say "skipped ${dir#"$KIT"/}: npm not found"; continue
    fi
    say "npm ci  ${dir#"$KIT"/}"
    [ "$DRY" = 1 ] && continue
    local log; log="$(log_dir)/npm-${dir##*/}.log"
    (cd "$dir" && npm ci --no-audit --no-fund) >"$log" 2>&1 || fail "npm ci ${dir#"$KIT"/}: see $log"
  done
}

# Add the kit to pi's packages in the kit's own pi directory (manifest
# "pi_package") and drop the entries the kit replaces (manifest "pi_retire",
# compared after ~ expansion). Writes are atomic and the previous
# settings.json is copied into the run's backup dir first.
register_pi_package() {
  local settings="$KIT/pi/settings.json" entry
  entry=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("pi_package", "~/agent-kit"))' "$MANIFEST")
  # A dotfiles-managed settings.json may be a symlink; write through it.
  [ -L "$settings" ] && settings=$(realpath -m -- "$settings")
  local plan
  plan=$(python3 - "$settings" "$entry" "$MANIFEST" "$HOME" "$DRY" <<'PY'
import json, os, sys
path, entry, manifest, home, dry = sys.argv[1:6]
def key(p):
    # Entries are strings or {"source": ..., ...} objects (pi docs/packages.md).
    return p["source"] if isinstance(p, dict) else p
def expand(p):
    p = key(p)
    if p.startswith("~/"):
        p = os.path.join(home, p[2:])
    if p.startswith("/"):
        return os.path.normpath(p)
    return p
try:
    data = json.load(open(path))
except FileNotFoundError:
    data = {}
pkgs = data.setdefault("packages", [])
m = json.load(open(manifest))
retire = {expand(p) for p in m.get("pi_retire", [])}
dropped = [p for p in pkgs if expand(p) in retire]
kept = [p for p in pkgs if expand(p) not in retire]
added = not any(expand(p) == expand(entry) for p in kept)
if added:
    kept.append(entry)
if not dropped and not added:
    print("NOOP")
    sys.exit(0)
data["packages"] = kept
if dry == "0":
    with open(path + ".tmp", "w") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
        f.write("\n")
print("CHANGED")
for p in dropped:
    print(f"retire {json.dumps(key(p))}")
if added:
    print(f"add {entry}")
PY
) || { fail "pi package registration"; return 1; }
  if [ "$plan" = NOOP ]; then say "ok      pi package $entry"; return 0; fi
  if [ "$DRY" = 1 ]; then
    printf '%s\n' "$plan" | sed -n '2,$p' | sed "s|^|pi      |; s|\$| in $settings|"; return 0
  fi
  mkdir -p -- "$(dirname -- "$settings")"
  if [ -f "$settings" ]; then
    ensure_backup_dir
    local dest; dest=$(backup_path "$settings")
    mkdir -p -- "$(dirname -- "$dest")" && cp -p -- "$settings" "$dest" || { fail "backup $settings"; rm -f -- "$settings.tmp"; return 1; }
    say "backup  $settings -> $dest"
  fi
  mv -f -- "$settings.tmp" "$settings" || { fail "write $settings"; return 1; }
  printf '%s\n' "$plan" | sed -n '2,$p' | sed "s|^|pi      |; s|\$| in $settings|"
}

# The harness variables are the owner's to set (environment.d, shell rc, or a
# dotfiles manager); say which ones this shell lacks.
note_environment() {
  python3 - "$MANIFEST" "$KIT" <<'PY'
import json, os, sys
m = json.load(open(sys.argv[1])); kit = sys.argv[2]
for h in m.get("harnesses", []):
    want = os.path.join(kit, h["name"])
    have = os.environ.get(h["env"])
    if not have:
        print(f"note    {h['env']} is unset in this shell; set it to {want}")
    elif os.path.realpath(os.path.expanduser(have)) != os.path.realpath(want):
        print(f"note    {h['env']}={have}; this kit expects {want}")
PY
}

check_root || { [ "$DRY" = 1 ] || exit 1; }
ensure_bindings
migrate_legacy
ensure_links
build_and_link_tools
install_extension_deps
register_pi_package
note_environment

if [ "$DRY" = 1 ]; then
  say "dry-run: nothing changed"
  exit 0
fi
rc=0
[ "$MISSING" = 0 ] && [ "$FAILED" = 0 ] || rc=1
if [ -x "$KIT/bin/check" ]; then
  "$KIT/bin/check" || rc=1
fi
exit $rc
