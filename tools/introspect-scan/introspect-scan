#!/usr/bin/env python3
"""Scan journals for steering-artifact usage: skill invocations and wiki touches.

The read side of the introspect sweep (the kit's docs/specs/2026-09-01-introspect.md).
Scans journal episodes for skill invocations and wiki note touches. An
episode carrying a `## Files` section (autojournal 2.1, policy pi-visible-v3,
live or backfilled) is read exactly: a successful `read`, `bash`, or
`child:read` of a file under `skills/<name>/` is an invocation of that skill
and of a wiki note filename a touch. Older episodes fall back to the
harness's skill-injection marker (pi's `<skill name="x"` tag, Claude Code's
`Base directory for this skill: .../skills/x` line). Path-shaped skill
mentions (`skills/<name>`, `<name>/SKILL.md`) in prose outside injected
skill bodies and the Files section are reported separately, and friction
notes in the inbox are inventoried. `--episodes <artifact>` lists the
episodes behind a count so the sweep can sample them; `--write` appends the
dated snapshot under the wiki's `metrics/introspect/` so months compare.

Measurement bias, by construction: an invocation marker undercounts influence
(a skill absorbed into habit leaves no marker; prose mentions are deliberately
not counted) and a path mention mostly measures curation (sessions that edit a
skill name its path without following it). Injected skill bodies are stripped
before matching so a skill citing another skill's files does not count as that
skill's use. Read the numbers as trend signal for the periodic introspect
sweep, never as a per-artifact verdict.
"""
import argparse
import collections
import datetime
import pathlib
import re
import sys

LANES = ["core", "platform", "infra", "personal", "knowledge", "reference", "work"]
GENERIC = {"index.md", "log.md", "README.md", "AGENTS.md", "CLAUDE.md"}
RECENT_DAYS = 30
EPISODE_CAP = 20
AGENTS = pathlib.Path.home() / ".agents"
# Injected skill text stripped before matching mentions and note touches, so
# neither the marker nor the body's own citations count as the session's: pi's
# <skill ...>...</skill> block, and Claude Code's marker line (its body has no
# closing delimiter, so the body itself stays).
INJECTED = re.compile(
    r'<skill name="[^"]+"[^>]*>.*?(?:</skill>|\Z)|Base directory for this skill:[^\n]*',
    re.S)
# autojournal's consultation footprint: the body's trailing `## Files`
# section, one `- <op> <target>` line per entry. Only successful reads are
# consultation; `read!`/`child:read!` are failures and `memory_get`/
# `web_fetch` are not corpus files.
FILES_SECTION = re.compile(r"\n\n## Files\n\n((?:- \S+ [^\n]*\n)+)\Z")
CONSULT_OPS = {"read", "bash", "child:read"}
# Only episodes captured under a policy that renders the section are read
# this way; in older episodes a Files-shaped tail is owner text. The scanner
# cannot verify the digest, so the policy line is its authority signal.
FILES_POLICY = re.compile(r"^capture_policy: pi-visible-v(?:[3-9]|\d{2,})$", re.M)


def consulted(text):
    """Returns ((op, target) pairs, body_without_files_section) or (None, text)."""
    m = FILES_SECTION.search(text) if FILES_POLICY.search(text) else None
    if m is None:
        return None, text
    entries = []
    for line in m.group(1).splitlines():
        op, _, target = line[2:].partition(" ")
        if op in CONSULT_OPS:
            entries.append((op, target))
    return entries, text[:m.start()] + "\n"


def parse_args():
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("--journals", type=pathlib.Path, default=AGENTS / "journals")
    p.add_argument("--skills", type=pathlib.Path, default=AGENTS / "skills")
    p.add_argument("--wiki", type=pathlib.Path, default=AGENTS / "wiki")
    p.add_argument("--today", type=datetime.date.fromisoformat,
                   default=datetime.date.today())
    p.add_argument("--episodes", metavar="ARTIFACT",
                   help="list episodes referencing this skill name or note filename "
                        f"(newest first, at most {EPISODE_CAP})")
    p.add_argument("--write", action="store_true",
                   help="also write the snapshot under <wiki>/metrics/introspect/")
    return p.parse_args()


def skill_names(root):
    return sorted(d.name for d in root.iterdir()
                  if d.is_dir() and (d / "SKILL.md").is_file())


def note_names(root):
    names = set()
    for lane in LANES:
        d = root / lane
        if not d.is_dir():
            continue
        for p in d.rglob("*.md"):
            if p.name in GENERIC or "link-maps" in p.parts:
                continue
            names.add(p.name)
    return names


def episode_date(path):
    m = re.search(r"/(\d{4})/(\d{2})/(\d{2})/", str(path))
    return datetime.date(int(m.group(1)), int(m.group(2)), int(m.group(3))) if m else None


NEVER = re.compile(r"(?!x)x()()")  # matches nothing, keeps two groups


def scan(journals, skills, notes):
    """Per episode: skills invoked, skills mentioned by path, notes touched.

    Invocation is the harness's injection marker. Mentions and note touches are
    matched after injected skill bodies are stripped.
    """
    names = "|".join(re.escape(s) for s in skills)
    invoke_pat = re.compile(
        r'<skill name="(%(n)s)"|Base directory for this skill: \S*/(%(n)s)(?![\w-])'
        % {"n": names}) if skills else NEVER
    skill_pat = re.compile(
        r"(?<![\w-])skills/(%(n)s)(?![\w-])|(?<![\w-])(%(n)s)/SKILL\.md"
        % {"n": names}) if skills else NEVER
    note_pat = re.compile(
        r"wiki/[A-Za-z0-9_/.-]*?([A-Za-z0-9_-]+\.md)|(?:^|[\s`'\"(/])((?:%s))(?![\w-])"
        % "|".join(re.escape(n) for n in sorted(notes))) if notes else NEVER
    files_skill = re.compile(r"(?<![\w-])skills/(%s)/" % names) if skills else NEVER
    rows = []  # (path, date, invoked, bash_only, mentioned, note_hits)
    for ep in sorted(journals.resolve().rglob("*.md")):
        try:
            text = ep.read_text(errors="replace")
        except OSError:
            continue
        entries, text = consulted(text)
        body = INJECTED.sub("", text)
        bash_only = set()
        if entries is None:
            invoked = {m.group(1) or m.group(2) for m in invoke_pat.finditer(text)}
            n_hits = {m.group(1) or m.group(2) for m in note_pat.finditer(body)} & notes
        else:
            # A bash path token is a `cat` as often as a `grep -l` or a test
            # fixture naming the file; only a read tool call is unambiguous.
            # Skills seen through bash alone are counted and reported apart.
            by_op = collections.defaultdict(set)
            for op, t in entries:
                m = files_skill.search(t)
                if m:
                    by_op[op].add(m.group(1))
            invoked = set().union(*by_op.values())
            bash_only = invoked - by_op["read"] - by_op["child:read"]
            n_hits = {t.rsplit("/", 1)[-1].split(":")[0] for _, t in entries} & notes
        mentioned = {m.group(1) or m.group(2) for m in skill_pat.finditer(body)}
        rows.append((ep, episode_date(ep), invoked, bash_only, mentioned, n_hits))
    return rows


def snapshot(rows, skills, notes, wiki, today):
    lines = [f"# introspect scan — {today}", ""]

    by_month = collections.Counter()
    skill_month = collections.Counter()
    wiki_month = collections.Counter()
    skill_hits = collections.Counter()
    skill_recent = collections.Counter()
    skill_mentions = collections.Counter()
    skill_bash_only = collections.Counter()
    note_hits = collections.Counter()
    cutoff = today - datetime.timedelta(days=RECENT_DAYS)
    for _, date, invoked, bash_only, mentioned, n_hits in rows:
        month = f"{date:%Y-%m}" if date else "unknown"
        by_month[month] += 1
        skill_month[month] += bool(invoked)
        wiki_month[month] += bool(n_hits)
        for s in invoked:
            skill_hits[s] += 1
            if date and cutoff < date <= today:
                skill_recent[s] += 1
        for s in bash_only:
            skill_bash_only[s] += 1
        for s in mentioned:
            skill_mentions[s] += 1
        for n in n_hits:
            note_hits[n] += 1

    lines.append("## episodes by month (skill-invoking/wiki-touching/total)")
    for month in sorted(by_month):
        lines.append(f"- {month}: {skill_month[month]}/{wiki_month[month]}/{by_month[month]}")
    lines.append("")

    lines.append(f"## skill invocations (episodes ever / last {RECENT_DAYS} days; "
                 "path mentions outside injected bodies, mostly curation; "
                 "bash-only: invocations seen through a bash path token alone)")
    seen = sorted(set(skill_hits) | set(skill_mentions),
                  key=lambda s: (-skill_hits[s], -skill_mentions[s], s))
    for name in seen:
        lines.append(f"- {skill_hits[name]:3d} / {skill_recent[name]}  {name}"
                     f"  mentions {skill_mentions[name]}"
                     f"  bash-only {skill_bash_only[name]}")
    never = [s for s in skills if s not in skill_hits]
    lines.append("- never invoked: " + (", ".join(never) if never else "none"))
    lines.append("")

    lines.append("## most-touched wiki notes (episodes)")
    for name, c in sorted(note_hits.items(), key=lambda kv: (-kv[1], kv[0]))[:10]:
        lines.append(f"- {c:3d}  {name}")
    lines.append(f"- distinct notes touched ever: {len(note_hits)} of {len(notes)}")
    lines.append("")

    inbox = [p for p in (wiki / "inbox").glob("*.md") if p.name != "README.md"]
    friction = sorted(p.name for p in inbox if p.name.startswith("friction-"))
    lines.append("## friction notes (inbox)")
    lines.extend(f"- {name}" for name in friction)
    lines.append(f"- friction total: {len(friction)}")
    lines.append("")
    lines.append(f"## inbox: {len(inbox) - len(friction)} untriaged + {len(friction)} friction")
    return "\n".join(lines) + "\n"


def main():
    args = parse_args()
    if args.episodes and args.write:
        sys.exit("--episodes and --write are mutually exclusive")
    skills = skill_names(args.skills)
    notes = note_names(args.wiki)
    rows = scan(args.journals, skills, notes)

    if args.episodes:
        target = args.episodes
        if target not in skills and target not in notes:
            sys.exit(f"unknown artifact: {target} (not a skill name or wiki note filename)")
        matches = [(date, ep,
                    "invoked-bash" if target in bo else "invoked" if target in inv else "mention")
                   for ep, date, inv, bo, men, n in rows
                   if target in inv or target in men or target in n]
        matches.sort(key=lambda r: (r[0] or datetime.date.min, r[1]), reverse=True)
        for date, ep, kind in matches[:EPISODE_CAP]:
            print(f"{kind}\t{ep}")
        if len(matches) > EPISODE_CAP:
            print(f"showing {EPISODE_CAP} of {len(matches)} episodes (newest first)",
                  file=sys.stderr)
        return

    report = snapshot(rows, skills, notes, args.wiki, args.today)
    print(report, end="")
    if args.write:
        dest = args.wiki / "metrics" / "introspect" / f"{args.today}.txt"
        if dest.exists():
            sys.exit(f"refusing to overwrite {dest} (it may hold sweep rulings); "
                     "remove it first to regenerate")
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(report)
        print(f"wrote {dest}", file=sys.stderr)


if __name__ == "__main__":
    main()
