#!/usr/bin/env python3
"""lemonade-hub-sync: reconcile the Lemonade model catalog with an on-disk
HuggingFace hub cache.

Disk is the truth. GGUF files present in the hub but not referenced by any
registered model get registered as `user.*` models (labelled `autosync`) via
the Lemonade API. Entries in user_models.json whose checkpoint files have all
vanished from disk are removed (with a timestamped backup), because Lemonade's
/api/v1/delete would delete files, not just unregister.

Adds go through the API so the running server persists and re-reads them
itself. Removals edit user_models.json directly; lemond re-reads that file on
model lookup (refresh_user_models_from_disk_for_lookup) and rebuilds its
cache, so no restart is needed either way.

Usage:
  lemonade-hub-sync [--dry-run] [--server URL] [--hub PATH] [--user-models PATH]
  lemonade-hub-sync --install-timer
"""

import argparse
import json
import os
import re
import shutil
import sys
import tempfile
import time
import urllib.request
import urllib.error

REASONING_RE = re.compile(r"(qwq|deepseek.?r1|[-_.]r1[-_.]|o1|o3|think|reasoning)", re.I)
MMProj_RE = re.compile(r"mmproj", re.I)


def hub_dir(arg):
    if arg:
        return os.path.expanduser(arg)
    hf_home = os.environ.get("HF_HOME")
    if hf_home:
        return os.path.join(os.path.expanduser(hf_home), "hub")
    return os.path.expanduser("~/models/hub")


def scan_hub(hub):
    """Return {repo: {"main": [(filename, bytes)], "mmproj": [(filename, bytes)]}}.

    Only GGUF files under snapshots/ are considered; blobs/ holds the same data
    under hash names and is ignored. safetensors-only repos are out of scope
    (not llamacpp-loadable).
    """
    repos = {}
    if not os.path.isdir(hub):
        return repos
    for entry in sorted(os.listdir(hub)):
        if not entry.startswith("models--"):
            continue
        repo = entry[len("models--"):].replace("--", "/")
        snap_root = os.path.join(hub, entry, "snapshots")
        if not os.path.isdir(snap_root):
            continue
        for root, _dirs, files in os.walk(snap_root):
            for f in files:
                if not f.lower().endswith(".gguf"):
                    continue
                path = os.path.join(root, f)
                try:
                    size = os.path.getsize(path)
                except OSError:
                    continue
                slot = "mmproj" if MMProj_RE.search(f) else "main"
                repos.setdefault(repo, {"main": [], "mmproj": []})[slot].append((f, size))
    for repo in repos:
        for slot in repos[repo]:
            repos[repo][slot].sort()
    return repos


def fetch_json(url, method="GET", body=None, timeout=15):
    data = None
    headers = {"Accept": "application/json"}
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    with urllib.request.urlopen(req, timeout=timeout) as res:
        return json.load(res)


def registered_checkpoints(models_payload):
    """All checkpoint refs the server knows: 'repo' or 'repo:file-or-variant'."""
    refs = set()
    for m in models_payload.get("data", []):
        cks = m.get("checkpoints") or {}
        single = m.get("checkpoint")
        values = list(cks.values()) + ([single] if isinstance(single, str) else [])
        for ref in values:
            if not isinstance(ref, str) or not ref.strip():
                continue
            refs.add(ref.strip())
    return refs


def split_ref(ref):
    repo, _, fname = ref.partition(":")
    return repo, fname


def ref_covers_file(ref, repo, fname):
    """True when a registered ref plausibly points at an on-disk GGUF file.

    Refs come in three shapes: bare repo (covers every file in it), exact
    filename, or a variant tag like 'UD-Q4_K_XL' that the server resolves by
    matching within real filenames.
    """
    r_repo, r_file = split_ref(ref)
    if r_repo != repo:
        return False
    if not r_file:
        return True
    return r_file == fname or r_file.lower() in fname.lower()


def entry_checkpoint_refs(entry):
    """Checkpoint refs from a user_models.json entry ('checkpoint' + 'checkpoints')."""
    refs = []
    single = entry.get("checkpoint")
    if isinstance(single, str) and single.strip():
        refs.append(single.strip())
    cks = entry.get("checkpoints") or {}
    if isinstance(cks, dict):
        refs.extend(v.strip() for v in cks.values() if isinstance(v, str) and v.strip())
    return refs


def ref_exists_on_disk(ref, hub):
    repo, fname = split_ref(ref)
    repo_dir = os.path.join(hub, "models--" + repo.replace("/", "--"))
    if not os.path.isdir(repo_dir):
        return False
    if not fname:
        return True  # whole-repo ref: repo dir present is enough
    snap_root = os.path.join(repo_dir, "snapshots")
    for root, _dirs, files in os.walk(snap_root):
        for f in files:
            # exact filename, or the ref is a variant tag inside a real name
            if f == fname or (f.lower().endswith(".gguf") and fname.lower() in f.lower()):
                return True
    return False


def derive_name(repo, fname, taken, qualify=False):
    stem = re.sub(r"\.gguf$", "", fname, flags=re.I)
    repo_stem = re.sub(r"-GGUF$", "", repo.split("/")[-1], flags=re.I)
    name = stem
    if qualify:
        # Repo carries a token the filename lacks (e.g. MTP): append it so the
        # name doesn't shadow the same-named file served from another repo.
        stem_tokens = set(stem.split("-"))
        extra = [t for t in repo_stem.split("-")
                 if t not in stem_tokens and t.upper() not in ("GGUF", "INSTRUCT")]
        name = f"{stem}-{'-'.join(extra)}" if extra else f"{repo_stem}-{stem}"
    if name in taken:
        name = f"{repo_stem}-{stem}"
    i = 2
    base = name
    while name in taken:
        name = f"{base}-{i}"
        i += 1
    return name


def labels_for(name, has_mmproj):
    labels = ["custom", "autosync"]
    low = name.lower()
    if "embedding" in low:
        labels.append("embeddings")
    if "rerank" in low:
        labels.append("reranking")
    if has_mmproj:
        labels.append("vision")
    if REASONING_RE.search(name):
        labels.append("reasoning")
    return labels


def plan_additions(repos, covered, taken):
    """One user.* registration per uncovered GGUF file.

    A file is skipped only when another repo holds a same-named,
    same-sized file that is already covered: that is the signature of
    weights republished across repos (e.g. unsloth base vs MTP), whereas
    same-named files of different sizes are distinct quantizations and
    both get registered.
    """
    plan = []
    skips = []
    for repo, slots in sorted(repos.items()):
        mmproj = slots["mmproj"][0][0] if slots["mmproj"] else None
        for fname, size in slots["main"]:
            if any(ref_covers_file(ref, repo, fname) for ref in covered):
                continue
            twin = next(
                (other for other, oslots in repos.items()
                 if other != repo and any(f == fname and s == size for f, s in oslots["main"])),
                None,
            )
            if twin and any(ref_covers_file(ref, twin, fname) for ref in covered):
                skips.append((repo, fname, twin))
                continue
            clash = any(
                split_ref(ref)[1] == fname and split_ref(ref)[0] != repo
                for ref in covered
            )
            name = derive_name(repo, fname, taken, qualify=clash)
            taken.add(name)
            cks = {"main": f"{repo}:{fname}"}
            if mmproj:
                cks["mmproj"] = f"{repo}:{mmproj}"
            plan.append({
                "model_name": f"user.{name}",
                "recipe": "llamacpp",
                "checkpoints": cks,
                "labels": labels_for(name, bool(mmproj)),
                "size": round(size / 1e9, 2),
                "suggested": True,
            })
    return plan, skips


def plan_removals(user_models, hub):
    """User-model entries whose referenced files are all gone from disk."""
    stale = []
    for name, entry in user_models.items():
        refs = entry_checkpoint_refs(entry)
        if not refs:
            continue  # nothing to verify against; leave it alone
        if not any(ref_exists_on_disk(r, hub) for r in refs):
            stale.append(name)
    return stale


def apply_removals(user_models_path, stale, dry_run):
    if not stale:
        return
    if dry_run:
        return
    backup = f"{user_models_path}.bak-autosync-{time.strftime('%Y%m%d-%H%M%S')}"
    shutil.copy2(user_models_path, backup)
    data = json.load(open(user_models_path))
    for name in stale:
        data.pop(name, None)
    tmp = user_models_path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, user_models_path)
    print(f"  backup: {backup}")


def signal_extra_models_rescan(server):
    """Trigger Lemonade's recursive extra_models_dir scan.

    Lemonade 11.7 watches only the configured root with inotify. Downloads and
    deletions below an existing child directory do not invalidate its model
    cache. A temporary non-GGUF file at the root generates the event without
    becoming a catalog entry.
    """
    try:
        config = fetch_json(f"{server}/internal/config")
        extra = config.get("extra_models_dir")
        if not extra:
            return True
        extra = os.path.expanduser(extra)
        if not os.path.isdir(extra):
            print(f"extra_models_dir refresh FAILED: not a directory: {extra}")
            return False
        fd, marker = tempfile.mkstemp(prefix=".lemonade-refresh-", dir=extra)
        os.close(fd)
        try:
            # Let inotify observe creation before deletion. Either event causes
            # cache invalidation; the marker is ignored because it is not GGUF.
            time.sleep(0.2)
        finally:
            os.unlink(marker)
        print(f"extra_models_dir refresh signalled: {extra}")
        return True
    except (OSError, ValueError, urllib.error.URLError) as e:
        print(f"extra_models_dir refresh FAILED: {e}")
        return False


def install_timer():
    unit_dir = os.path.expanduser("~/.config/systemd/user")
    os.makedirs(unit_dir, exist_ok=True)
    exe = shutil.which("lemonade-hub-sync") or os.path.realpath(sys.argv[0])
    service = f"""[Unit]
Description=Reconcile Lemonade catalog with the on-disk HF hub cache

[Service]
Type=oneshot
ExecStart={exe}
"""
    timer = """[Unit]
Description=Periodic Lemonade hub sync

[Timer]
OnBootSec=2min
OnUnitActiveSec=10min

[Install]
WantedBy=timers.target
"""
    with open(os.path.join(unit_dir, "lemonade-hub-sync.service"), "w") as f:
        f.write(service)
    with open(os.path.join(unit_dir, "lemonade-hub-sync.timer"), "w") as f:
        f.write(timer)
    os.system("systemctl --user daemon-reload")
    os.system("systemctl --user enable --now lemonade-hub-sync.timer")
    print("timer installed: runs 2min after login, then every 10min")


def main():
    ap = argparse.ArgumentParser(description="Sync Lemonade catalog with the on-disk HF hub cache")
    ap.add_argument("--server", default=os.environ.get("LEMONADE_URL", "http://127.0.0.1:13305"))
    ap.add_argument("--hub", default=None, help="HF hub path (default: $HF_HOME/hub or ~/models/hub)")
    ap.add_argument("--user-models", default=os.path.expanduser("~/.cache/lemonade/user_models.json"))
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--install-timer", action="store_true")
    args = ap.parse_args()

    if args.install_timer:
        install_timer()
        return 0

    hub = hub_dir(args.hub)
    repos = scan_hub(hub)
    n_gguf = sum(len(s["main"]) for s in repos.values())
    print(f"hub: {hub} — {len(repos)} repos, {n_gguf} GGUF files")

    payload = fetch_json(f"{args.server}/api/v1/models?show_all=true")
    covered = registered_checkpoints(payload)
    taken = {m.get("id", "") for m in payload.get("data", [])}
    taken |= {n[5:] for n in taken if n.startswith("user.")}

    additions, skips = plan_additions(repos, covered, taken)
    print(f"additions: {len(additions)}")
    for a in additions:
        print(f"  + {a['model_name']} <- {a['checkpoints']['main']} ({a['size']}G)")
        if not args.dry_run:
            try:
                fetch_json(f"{args.server}/api/v1/models/register", method="POST", body=a)
            except urllib.error.HTTPError as e:
                print(f"    FAILED: {e.code} {e.read().decode()[:200]}")
    for repo, fname, other in skips:
        print(f"  ~ skip {repo}:{fname} (same file already served from {other})")

    user_models = {}
    if os.path.exists(args.user_models):
        user_models = json.load(open(args.user_models))
    stale = plan_removals(user_models, hub)
    print(f"removals (files gone): {len(stale)}")
    for name in stale:
        print(f"  - {name}")
    apply_removals(args.user_models, stale, args.dry_run)

    if args.dry_run:
        print("dry run: no changes made")
        return 0

    return 0 if signal_extra_models_rescan(args.server) else 1


if __name__ == "__main__":
    sys.exit(main())
