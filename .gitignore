# The kit is the install target: bindings that bin/install links at the root
# and the machine files the owner keeps beside them (guidance/*.example).
/wiki
/inbox
/journals
/reference
/projects
/MACHINE.md
/system-tools-index.md
/verification-toolbox.md
/.skill-lock.json

# Caches and bytecode.
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store
*~
*.swp

# Owner-identifying patterns consumed by bin/check --scan. Never tracked: the
# gate is publishable, the strings it guards are not. See
# bin/forbidden.local.txt.example.
bin/forbidden.local.txt

# Tool build output.
zig-out/
.zig-cache/
dist/
build/
!skills/build/
target/

# Extension dependencies and captured runs.
node_modules/
.venv/
artifacts/
**/test-artifacts/

# Scratch and throwaway work.
notes/
scratch/
*.log
*.tmp


# Secrets and local overrides.
.env
*.local
*.key
*.pem
*.secret
