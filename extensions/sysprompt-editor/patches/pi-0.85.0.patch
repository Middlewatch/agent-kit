diff --git a/packages/coding-agent/test/scoped-instructions.test.ts b/packages/coding-agent/test/scoped-instructions.test.ts
new file mode 100644
index 0000000..c0c5946
--- /dev/null
+++ b/packages/coding-agent/test/scoped-instructions.test.ts
@@ -0,0 +1,56 @@
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, expect, test } from "vitest";
+import { DefaultResourceLoader } from "../src/core/resource-loader.ts";
+import { SettingsManager } from "../src/core/settings-manager.ts";
+import { buildSystemPrompt } from "../src/core/system-prompt.ts";
+
+const roots: string[] = [];
+afterEach(() => {
+	for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true });
+});
+
+test.each([undefined, "CUSTOM CORE"])(
+	"real loader preserves instruction authority with %s core",
+	async (customPrompt) => {
+		const root = mkdtempSync(join(tmpdir(), "pi-scopes-"));
+		roots.push(root);
+		const agentDir = join(root, "agent");
+		const parent = join(root, "workspace");
+		const cwd = join(parent, "nested");
+		mkdirSync(agentDir, { recursive: true });
+		mkdirSync(cwd, { recursive: true });
+		const content = "OPAQUE\n```\n<project_context> literal {{GLOBAL_INSTRUCTIONS}}\n```\n";
+		writeFileSync(join(agentDir, "AGENTS.md"), content);
+		writeFileSync(join(parent, "AGENTS.md"), "PARENT");
+		writeFileSync(join(cwd, "CLAUDE.md"), "NESTED");
+		const settingsManager = SettingsManager.inMemory();
+		settingsManager.setProjectTrusted(true);
+		const loader = new DefaultResourceLoader({
+			cwd,
+			agentDir,
+			settingsManager,
+			noExtensions: true,
+			noSkills: true,
+			noThemes: true,
+			noPromptTemplates: true,
+		});
+		await loader.reload();
+		const contextFiles = loader.getAgentsFiles().agentsFiles;
+		expect(contextFiles.map((f) => f.scope)).toEqual([
+			{ kind: "global" },
+			{ kind: "workspace", directory: parent },
+			{ kind: "workspace", directory: cwd },
+		]);
+		const prompt = buildSystemPrompt({ cwd, contextFiles, customPrompt });
+		expect(prompt).toContain(
+			`<global_instructions path="${join(agentDir, "AGENTS.md")}">\n${content}\n</global_instructions>`,
+		);
+		expect(prompt).toContain(
+			`<workspace_instructions path="${join(parent, "AGENTS.md")}" directory="${parent}">\nPARENT\n</workspace_instructions>`,
+		);
+		expect(prompt.indexOf("PARENT")).toBeLessThan(prompt.indexOf("NESTED"));
+		expect(prompt).not.toContain("Project-specific instructions and guidelines:");
+	},
+);
diff --git a/packages/coding-agent/test/session-custom-persistence.test.ts b/packages/coding-agent/test/session-custom-persistence.test.ts
new file mode 100644
index 0000000..840ebdd
--- /dev/null
+++ b/packages/coding-agent/test/session-custom-persistence.test.ts
@@ -0,0 +1,52 @@
+import { existsSync, mkdirSync, mkdtempSync, readFileSync, renameSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, expect, test } from "vitest";
+import { SessionManager } from "../src/core/session-manager.ts";
+
+const roots: string[] = [];
+afterEach(() => {
+	for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true });
+});
+
+function manager() {
+	const root = mkdtempSync(join(tmpdir(), "pi-custom-persist-"));
+	roots.push(root);
+	return SessionManager.create(root, root);
+}
+
+test("custom state is written before the first assistant and restored on open", () => {
+	const sm = manager();
+	sm.appendCustomEntry("selection", { name: "voice.md" });
+	expect(existsSync(sm.getSessionFile()!)).toBe(true);
+	expect(SessionManager.open(sm.getSessionFile()!).getBranch().at(-1)).toMatchObject({
+		type: "custom",
+		data: { name: "voice.md" },
+	});
+});
+
+test("failed initial custom write leaves no in-memory selection", () => {
+	const sm = manager();
+	const before = sm.getEntries();
+	mkdirSync(sm.getSessionFile()!);
+	expect(() => sm.appendCustomEntry("selection", { name: "voice.md" })).toThrow();
+	expect(sm.getEntries()).toEqual(before);
+	expect(sm.getLeafId()).toBe(null);
+});
+
+test("failed subsequent custom write retains previous branch and disk state", () => {
+	const sm = manager();
+	const first = sm.appendCustomEntry("selection", { name: "one.md" });
+	const file = sm.getSessionFile()!;
+	const bytes = readFileSync(file, "utf8");
+	renameSync(file, `${file}.saved`);
+	mkdirSync(file);
+	expect(() => sm.appendCustomEntry("selection", { name: "two.md" })).toThrow();
+	expect(sm.getLeafId()).toBe(first);
+	expect(sm.getBranch()).toHaveLength(1);
+	rmSync(file, { recursive: true });
+	renameSync(`${file}.saved`, file);
+	expect(readFileSync(file, "utf8")).toBe(bytes);
+	sm.appendCustomEntry("selection", { name: "three.md" });
+	expect(SessionManager.open(file).getBranch().at(-1)).toMatchObject({ data: { name: "three.md" } });
+});
