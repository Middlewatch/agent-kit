+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, expect, test } from "vitest";
+import { AuthStorage } from "../src/core/auth-storage.ts";
+import { ExtensionRunner } from "../src/core/extensions/runner.ts";
+import type { ExtensionFactory } from "../src/core/extensions/types.ts";
+import { DefaultResourceLoader } from "../src/core/resource-loader.ts";
+import { SessionManager } from "../src/core/session-manager.ts";
+import { SettingsManager } from "../src/core/settings-manager.ts";
+import { createInMemoryModelRegistry } from "./model-runtime-test-utils.ts";
+import { fauxModel } from "./test-harness.ts";
+
+const roots: string[] = [];
+afterEach(() => {
+	for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true });
+});
+async function runner(extensionFactories: ExtensionFactory[]) {
+	const root = mkdtempSync(join(tmpdir(), "pi-provenance-"));
+	roots.push(root);
+	const loader = new DefaultResourceLoader({
+		cwd: root,
+		agentDir: root,
+		settingsManager: SettingsManager.inMemory(),
+		noExtensions: true,
+		noSkills: true,
+		noThemes: true,
+		noPromptTemplates: true,
+		extensionFactories,
+	});
+	await loader.reload();
+	const loaded = loader.getExtensions();
+	expect(loaded.errors).toEqual([]);
+	return new ExtensionRunner(
+		loaded.extensions,
+		loaded.runtime,
+		root,
+		SessionManager.inMemory(),
+		await createInMemoryModelRegistry(AuthStorage.inMemory()),
+	);
+}
+
+test("each before-start handler sees the original prompt as well as the current transformed prompt", async () => {
+	const seen: string[] = [];
+	const r = await runner([
+		(pi) => {
+			pi.on("before_agent_start", () => ({ systemPrompt: "TRANSFORMED" }));
+		},
+		(pi) => {
+			pi.on("before_agent_start", (event) => {
+				seen.push(event.originalSystemPrompt, event.systemPrompt);
+			});
+		},
+	]);
+	await r.emitBeforeAgentStart("probe", undefined, "ORIGINAL", { cwd: "/fixture" });
+	expect(seen).toEqual(["ORIGINAL", "TRANSFORMED"]);
+});
+
+test("post-transform observation cannot change transport payload or another observer's snapshot", async () => {
+	const seen: unknown[] = [];
+	const r = await runner([
+		(pi) => {
+			pi.on("before_provider_request", () => ({ system: "FINAL" }));
+			pi.on("provider_request", (event) => {
+				(event.payload as { system: string }).system = "MUTATED";
+				event.model.id = "MUTATED";
+				throw new Error("observer failure");
+			});
+		},
+		(pi) => {
+			pi.on("provider_request", (event) => {
+				seen.push(event.payload, event.model.id);
+			});
+		},
+	]);
+	const payload = await r.emitBeforeProviderRequest({ system: "INITIAL" });
+	await r.emitProviderRequest(payload, fauxModel);
+	expect(payload).toEqual({ system: "FINAL" });
+	expect(seen).toEqual([{ system: "FINAL" }, fauxModel.id]);
+});
