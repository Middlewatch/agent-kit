{
  "name": "pageview",
  "version": "0.0.1",
  "description": "Serve session browser artifacts (HTML, SVG, PDF) to a remote browser over the tailnet, with localhost fallback.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
