{
  "name": "@middlewatch/pi-agent-kit",
  "version": "0.1.0",
  "type": "module",
  "description": "Agent kit: global guidance, skills, pi extensions, prompt templates, and tools behind the ~/.agents convention",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "skills"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Middlewatch/agent-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Middlewatch/agent-kit.git"
  },
  "bugs": "https://github.com/Middlewatch/agent-kit/issues",
  "files": [
    "extensions",
    "prompts",
    "guidance/sysprompt",
    "skills/deep-research/pi",
    "CHANGELOG.md",
    "!**/node_modules",
    "!**/artifacts",
    "!**/test-artifacts",
    "!**/__pycache__",
    "!guidance/sysprompt/.active",
    "!**/*.log"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-interlock/index.ts",
      "./extensions/pi-scratchpad/src/index.ts",
      "./extensions/agent-delegate/index.ts",
      "./extensions/todo/index.ts",
      "./extensions/pageview/src/index.ts",
      "./extensions/pi-tui/src/index.ts",
      "./extensions/prompt-picker/index.ts",
      "./extensions/sysprompt-editor/index.ts",
      "./extensions/pi-config/index.ts"
    ],
    "prompts": [
      "./prompts/*.md",
      "!prompts/README.md"
    ],
    "skills": [
      "./skills/deep-research/pi"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
