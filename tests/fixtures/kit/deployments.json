{
  "root": "~/agent-kit",
  "bindings": {
    "wiki": "~/wiki",
    "reference": "~/reference",
    "projects": "~/projects"
  },
  "harnesses": [
    {"name": "pi", "env": "PI_CODING_AGENT_DIR", "legacy": "~/.pi/agent"},
    {"name": "claude", "env": "CLAUDE_CONFIG_DIR", "legacy": "~/.claude"},
    {"name": "codex", "env": "CODEX_HOME", "legacy": "~/.codex"}
  ],
  "legacy_bindings": "~/.agents",
  "links": [
    {"source": "~/agent-kit/guidance/AGENTS.md", "target": "~/agent-kit/projects/AGENTS.md"},
    {"source": "AGENTS.md", "target": "~/agent-kit/projects/CLAUDE.md"}
  ],
  "tools": [
    {"name": "demo-script", "bin": "tools/demo-script/demo-script"},
    {"name": "demo-built", "bin": "tools/demo-built/out/demo-built", "build": "zig build"}
  ],
  "pi_package": "~/agent-kit",
  "pi_retire": ["~/.agents/kit", "~/old-kit"]
}
